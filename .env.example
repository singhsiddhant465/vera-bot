# Copy to .env (or set in your host's dashboard) before submitting.
# Only VERA_CONTACT_EMAIL truly must change — the rest have sane defaults.

VERA_TEAM_NAME="Siddhant Singh"
VERA_TEAM_MEMBERS="Siddhant Singh"
VERA_CONTACT_EMAIL="REPLACE_WITH_YOUR_DTU_COLLEGE_EMAIL@dtu.ac.in"   # <-- REQUIRED: your college email ID
VERA_MODEL="vera-deterministic-composer/no-llm"
VERA_VERSION="1.0.0"
# VERA_SUBMITTED_AT is set automatically; override only if the portal wants a specific timestamp.

# --- optional LLM rephraser (leave off for a fully deterministic, offline bot) ---
# VERA_LLM_ENHANCE="1"
# ANTHROPIC_API_KEY="sk-ant-..."
